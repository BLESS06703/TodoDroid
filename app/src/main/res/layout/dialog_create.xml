<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_bg"
    android:paddingHorizontal="24dp"
    android:paddingTop="20dp"
    android:paddingBottom="40dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="#444444"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Create New"
        android:textSize="20sp"
        android:textColor="#FFFFFF"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="20dp" />

    <!-- Type selector -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:background="@drawable/segment_bg"
        android:padding="4dp"
        android:layout_marginBottom="20dp">

        <TextView
            android:id="@+id/type_task"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Task"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:background="@drawable/segment_selected"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/type_note"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Note"
            android:textSize="14sp"
            android:textColor="#888888"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:background="@drawable/segment_unselected"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- Title input -->
    <EditText
        android:id="@+id/input_title"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:hint="Title"
        android:textColorHint="#666666"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:fontFamily="sans-serif"
        android:background="@drawable/input_bg"
        android:paddingHorizontal="16dp"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp"
        android:inputType="text"
        android:imeOptions="actionNext" />

    <!-- Content input -->
    <EditText
        android:id="@+id/input_content"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:hint="Description (optional)"
        android:textColorHint="#666666"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:fontFamily="sans-serif"
        android:background="@drawable/input_bg"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:gravity="top"
        android:layout_marginBottom="16dp"
        android:inputType="textMultiLine" />

    <!-- Create button -->
    <TextView
        android:id="@+id/btn_create_item"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Create"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:background="@drawable/btn_create_bg"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
