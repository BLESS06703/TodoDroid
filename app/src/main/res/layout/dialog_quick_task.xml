<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_bg"
    android:paddingHorizontal="24dp"
    android:paddingTop="20dp"
    android:paddingBottom="40dp">

    <View android:layout_width="40dp" android:layout_height="4dp" android:background="#444444"
        android:layout_gravity="center_horizontal" android:layout_marginBottom="20dp" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Quick Task" android:textSize="20sp" android:textColor="#FFFFFF"
        android:fontFamily="sans-serif-medium" android:layout_marginBottom="16dp" />

    <EditText android:id="@+id/quick_task_input" android:layout_width="match_parent"
        android:layout_height="54dp" android:hint="What needs to be done?"
        android:textColorHint="#666666" android:textColor="#FFFFFF" android:textSize="15sp"
        android:fontFamily="sans-serif" android:background="@drawable/input_bg"
        android:paddingHorizontal="16dp" android:gravity="center_vertical"
        android:inputType="text" android:imeOptions="actionNext"
        android:layout_marginBottom="12dp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="54dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@drawable/input_bg" android:paddingHorizontal="16dp"
        android:layout_marginBottom="16dp">

        <ImageView android:layout_width="20dp" android:layout_height="20dp"
            android:src="@android:drawable/ic_menu_today" android:tint="#888888"
            android:layout_marginEnd="10dp" />

        <TextView android:id="@+id/due_date_text" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Set due date (optional)" android:textSize="14sp"
            android:textColor="#666666" android:fontFamily="sans-serif"
            android:clickable="true" android:focusable="true" />

        <TextView android:id="@+id/btn_clear_date" android:layout_width="28dp"
            android:layout_height="28dp" android:text="X" android:textSize="14sp"
            android:textColor="#555555" android:gravity="center" android:visibility="gone"
            android:clickable="true" android:focusable="true" />

    </LinearLayout>

    <TextView android:id="@+id/btn_add_task" android:layout_width="match_parent"
        android:layout_height="52dp" android:text="Add Task" android:textSize="16sp"
        android:textColor="#FFFFFF" android:fontFamily="sans-serif-medium"
        android:gravity="center" android:background="@drawable/btn_create_bg"
        android:clickable="true" android:focusable="true" />

</LinearLayout>
