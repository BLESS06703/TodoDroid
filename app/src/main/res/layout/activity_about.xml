<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:gravity="center"
    android:padding="32dp">

    <ImageButton
        android:id="@+id/btn_back_about"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@android:drawable/ic_menu_revert"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Back"
        android:padding="8dp"
        android:tint="#888888"
        android:layout_gravity="start"
        android:layout_marginBottom="40dp" />

    <!-- Logo area -->
    <LinearLayout
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:background="@drawable/logo_bg"
        android:gravity="center"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BS"
            android:textSize="36sp"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold" />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TodoDroid"
        android:textSize="24sp"
        android:textColor="#FFFFFF"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="by BLESS SCOTT"
        android:textSize="14sp"
        android:textColor="#7C3AED"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Version 2.3"
        android:textSize="13sp"
        android:textColor="#888888"
        android:fontFamily="sans-serif"
        android:layout_marginBottom="40dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Built entirely on Android using Termux"
        android:textSize="13sp"
        android:textColor="#666666"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:layout_marginBottom="32dp" />

    <!-- Social links -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:id="@+id/link_github"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:text="GitHub"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:background="@drawable/social_btn_bg"
            android:layout_marginEnd="12dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/link_fb"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:text="FB"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:background="@drawable/social_btn_bg"
            android:layout_marginEnd="12dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/link_ig"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:text="IG"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:background="@drawable/social_btn_bg"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</LinearLayout>
