<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/popup_bg"
    android:elevation="16dp"
    android:paddingHorizontal="20dp"
    android:paddingTop="20dp"
    android:paddingBottom="16dp">

    <!-- SORT BY label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SORT BY"
        android:textSize="12sp"
        android:textColor="#888888"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.1"
        android:layout_marginBottom="12dp" />

    <!-- Latest first -->
    <LinearLayout
        android:id="@+id/sort_latest"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@drawable/popup_item_bg"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginBottom="2dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Latest first"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif" />

        <TextView
            android:id="@+id/check_latest"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:text="✓"
            android:textSize="16sp"
            android:textColor="#7C3AED"
            android:gravity="center"
            android:visibility="visible" />

    </LinearLayout>

    <!-- Oldest first -->
    <LinearLayout
        android:id="@+id/sort_oldest"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@drawable/popup_item_bg"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Oldest first"
            android:textSize="16sp"
            android:textColor="#B0B0B0"
            android:fontFamily="sans-serif" />

        <TextView
            android:id="@+id/check_oldest"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:text="✓"
            android:textSize="16sp"
            android:textColor="#7C3AED"
            android:gravity="center"
            android:visibility="invisible" />

    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#252525"
        android:layout_marginVertical="16dp" />

    <!-- VIEW AS label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="VIEW AS"
        android:textSize="12sp"
        android:textColor="#888888"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.1"
        android:layout_marginBottom="12dp" />

    <!-- Segmented control -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="@drawable/segment_bg"
        android:padding="4dp">

        <TextView
            android:id="@+id/view_list"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="List"
            android:textSize="15sp"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:background="@drawable/segment_selected"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/view_card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Card"
            android:textSize="15sp"
            android:textColor="#888888"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:background="@drawable/segment_unselected"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</LinearLayout>
