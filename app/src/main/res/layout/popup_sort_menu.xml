<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="180dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/popup_bg"
    android:elevation="8dp"
    android:padding="8dp">

    <!-- Sort section label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SORT BY"
        android:textSize="10sp"
        android:textColor="#888888"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.1"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/sort_latest"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:text="Latest first"
        android:textSize="14sp"
        android:textColor="#FFFFFF"
        android:fontFamily="sans-serif"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:background="@drawable/popup_item_bg"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/sort_oldest"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:text="Oldest first"
        android:textSize="14sp"
        android:textColor="#CCCCCC"
        android:fontFamily="sans-serif"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:background="@drawable/popup_item_bg"
        android:clickable="true"
        android:focusable="true" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2A2A2A"
        android:layout_marginVertical="6dp"
        android:layout_marginHorizontal="8dp" />

    <!-- View section label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="VIEW AS"
        android:textSize="10sp"
        android:textColor="#888888"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.1"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:background="@drawable/popup_item_bg">

        <TextView
            android:id="@+id/view_list"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="List"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:background="@drawable/pill_selected_small"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/view_card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Card"
            android:textSize="13sp"
            android:textColor="#888888"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:background="@drawable/pill_unselected_small"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</LinearLayout>
