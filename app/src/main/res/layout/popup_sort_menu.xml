<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="200dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/popup_bg"
    android:elevation="16dp"
    android:paddingHorizontal="12dp"
    android:paddingVertical="16dp">

    <!-- SORT BY section label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SORT BY"
        android:textSize="11sp"
        android:textColor="#888888"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.08"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="8dp" />

    <!-- Latest first -->
    <LinearLayout
        android:id="@+id/sort_latest"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:background="@drawable/popup_item_bg"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Latest first"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/check_latest"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:text="✓"
            android:textSize="14sp"
            android:textColor="#7C3AED"
            android:gravity="center"
            android:fontFamily="sans-serif"
            android:visibility="visible" />

    </LinearLayout>

    <!-- Oldest first -->
    <LinearLayout
        android:id="@+id/sort_oldest"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:background="@drawable/popup_item_bg"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Oldest first"
            android:textSize="14sp"
            android:textColor="#B0B0B0"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/check_oldest"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:text="✓"
            android:textSize="14sp"
            android:textColor="#7C3AED"
            android:gravity="center"
            android:fontFamily="sans-serif"
            android:visibility="invisible" />

    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#252525"
        android:layout_marginVertical="12dp"
        android:layout_marginHorizontal="8dp" />

    <!-- VIEW AS section label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="VIEW AS"
        android:textSize="11sp"
        android:textColor="#888888"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.08"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="10dp" />

    <!-- Segmented control -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:background="@drawable/segment_bg"
        android:padding="3dp"
        android:layout_marginHorizontal="4dp">

        <TextView
            android:id="@+id/view_list"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="List"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:background="@drawable/segment_selected"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/view_card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Card"
            android:textSize="13sp"
            android:textColor="#888888"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:background="@drawable/segment_unselected"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</LinearLayout>
