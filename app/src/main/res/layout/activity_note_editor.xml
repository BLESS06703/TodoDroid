<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:id="@+id/editor_root">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:background="#1A1A1A">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_revert"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="8dp"
            app:tint="#888888" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Edit Note"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="4dp" />

        <ImageButton
            android:id="@+id/btn_share"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_share"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Share"
            android:padding="8dp"
            app:tint="#888888" />

        <ImageButton
            android:id="@+id/btn_delete"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_delete"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Delete"
            android:padding="8dp"
            app:tint="#EF4444" />

        <TextView
            android:id="@+id/btn_save"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Save"
            android:textSize="14sp"
            android:textColor="#7C3AED"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless" />

    </LinearLayout>

    <EditText
        android:id="@+id/editor_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Note title"
        android:textColorHint="#99FFFFFF"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:background="@null"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="8dp"
        android:inputType="text"
        android:imeOptions="actionNext" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#33FFFFFF"
        android:layout_marginHorizontal="20dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:layout_marginTop="4dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Theme" android:textSize="11sp" android:textColor="#888888"
            android:fontFamily="sans-serif" android:layout_marginEnd="10dp" />

        <View android:id="@+id/color_default" android:layout_width="28dp" android:layout_height="28dp"
            android:background="@drawable/color_circle_white" android:layout_marginEnd="8dp"
            android:clickable="true" android:focusable="true" />
        <View android:id="@+id/color_red" android:layout_width="28dp" android:layout_height="28dp"
            android:background="@drawable/color_circle_red" android:layout_marginEnd="8dp"
            android:clickable="true" android:focusable="true" />
        <View android:id="@+id/color_orange" android:layout_width="28dp" android:layout_height="28dp"
            android:background="@drawable/color_circle_orange" android:layout_marginEnd="8dp"
            android:clickable="true" android:focusable="true" />
        <View android:id="@+id/color_yellow" android:layout_width="28dp" android:layout_height="28dp"
            android:background="@drawable/color_circle_yellow" android:layout_marginEnd="8dp"
            android:clickable="true" android:focusable="true" />
        <View android:id="@+id/color_green" android:layout_width="28dp" android:layout_height="28dp"
            android:background="@drawable/color_circle_green" android:layout_marginEnd="8dp"
            android:clickable="true" android:focusable="true" />
        <View android:id="@+id/color_blue" android:layout_width="28dp" android:layout_height="28dp"
            android:background="@drawable/color_circle_blue" android:layout_marginEnd="8dp"
            android:clickable="true" android:focusable="true" />
        <View android:id="@+id/color_purple" android:layout_width="28dp" android:layout_height="28dp"
            android:background="@drawable/color_circle_purple" android:layout_marginEnd="8dp"
            android:clickable="true" android:focusable="true" />
        <View android:id="@+id/color_dark" android:layout_width="28dp" android:layout_height="28dp"
            android:background="@drawable/color_circle_dark" android:layout_marginEnd="8dp"
            android:clickable="true" android:focusable="true" />

    </LinearLayout>

    <EditText
        android:id="@+id/editor_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:hint="Start writing..."
        android:textColorHint="#66FFFFFF"
        android:textColor="#E0E0E0"
        android:textSize="16sp"
        android:fontFamily="sans-serif"
        android:background="@null"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:gravity="top|start"
        android:inputType="textMultiLine|textCapSentences" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="#1A1A1A"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp">

            <TextView android:id="@+id/fmt_bold" android:layout_width="44dp" android:layout_height="40dp"
                android:text="B" android:textSize="18sp" android:textStyle="bold" android:textColor="#888888"
                android:gravity="center" android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true" android:focusable="true" />
            <TextView android:id="@+id/fmt_italic" android:layout_width="44dp" android:layout_height="40dp"
                android:text="I" android:textSize="18sp" android:textStyle="italic" android:textColor="#888888"
                android:gravity="center" android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true" android:focusable="true" />
            <TextView android:id="@+id/fmt_strike" android:layout_width="44dp" android:layout_height="40dp"
                android:text="S" android:textSize="16sp" android:textColor="#888888"
                android:gravity="center" android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true" android:focusable="true" />

            <View android:layout_width="1dp" android:layout_height="24dp" android:background="#333333"
                android:layout_marginHorizontal="4dp" />

            <TextView android:id="@+id/fmt_bullet" android:layout_width="44dp" android:layout_height="40dp"
                android:text="•" android:textSize="20sp" android:textColor="#888888"
                android:gravity="center" android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true" android:focusable="true" />
            <TextView android:id="@+id/fmt_number" android:layout_width="44dp" android:layout_height="40dp"
                android:text="1." android:textSize="16sp" android:textColor="#888888"
                android:gravity="center" android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true" android:focusable="true" />

            <View android:layout_width="1dp" android:layout_height="24dp" android:background="#333333"
                android:layout_marginHorizontal="4dp" />

            <TextView android:id="@+id/fmt_align_left" android:layout_width="44dp" android:layout_height="40dp"
                android:text="⫷" android:textSize="16sp" android:textColor="#888888"
                android:gravity="center" android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true" android:focusable="true" />
            <TextView android:id="@+id/fmt_align_center" android:layout_width="44dp" android:layout_height="40dp"
                android:text="⫿" android:textSize="16sp" android:textColor="#888888"
                android:gravity="center" android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true" android:focusable="true" />
            <TextView android:id="@+id/fmt_align_right" android:layout_width="44dp" android:layout_height="40dp"
                android:text="⫸" android:textSize="16sp" android:textColor="#888888"
                android:gravity="center" android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true" android:focusable="true" />

            <View android:layout_width="1dp" android:layout_height="24dp" android:background="#333333"
                android:layout_marginHorizontal="4dp" />

            <TextView android:id="@+id/fmt_indent_inc" android:layout_width="44dp" android:layout_height="40dp"
                android:text="→" android:textSize="18sp" android:textColor="#888888"
                android:gravity="center" android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true" android:focusable="true" />
            <TextView android:id="@+id/fmt_indent_dec" android:layout_width="44dp" android:layout_height="40dp"
                android:text="←" android:textSize="18sp" android:textColor="#888888"
                android:gravity="center" android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true" android:focusable="true" />

            <View android:layout_width="1dp" android:layout_height="24dp" android:background="#333333"
                android:layout_marginHorizontal="4dp" />

            <ImageButton android:id="@+id/fmt_mic" android:layout_width="40dp" android:layout_height="40dp"
                android:src="@android:drawable/ic_btn_speak_now"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Speech to text" android:padding="8dp" app:tint="#888888" />

            <View android:layout_width="1dp" android:layout_height="24dp" android:background="#333333"
                android:layout_marginHorizontal="4dp" />

            <ImageButton android:id="@+id/fmt_camera" android:layout_width="40dp" android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_camera"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Camera" android:padding="8dp" app:tint="#888888" />

        </LinearLayout>
    </HorizontalScrollView>

</LinearLayout>
